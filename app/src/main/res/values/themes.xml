<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PhotoViewer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#3498db</item>
        <item name="colorPrimaryVariant">#2980b9</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#2c3e50</item>
        <item name="colorSecondaryVariant">#34495e</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <item name="myBackground">@color/light_background</item>
        <item name="mySurface">@color/light_surface</item>
        <item name="myOnBackground">@color/light_on_background</item>
        <item name="myOnSurface">@color/light_on_surface</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PhotoViewer.Light" parent="Theme.PhotoViewer">
        <item name="android:windowBackground">@color/light_background</item>
        <item name="myBackground">@color/light_background</item>
        <item name="mySurface">@color/light_surface</item>
        <item name="myOnBackground">@color/light_on_background</item>
        <item name="myOnSurface">@color/light_on_surface</item>
    </style>

    <style name="Theme.PhotoViewer.Light.FullScreen" parent="Theme.PhotoViewer.Light">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.PhotoViewer.Dark" parent="Theme.PhotoViewer">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="myBackground">@color/dark_background</item>
        <item name="mySurface">@color/dark_surface</item>
        <item name="myOnBackground">@color/dark_on_background</item>
        <item name="myOnSurface">@color/dark_on_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PhotoViewer.Dark.FullScreen" parent="Theme.PhotoViewer.Dark">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>


</resources>